
public class Main {
    public static void main(String[] args) {

        long first = 0;
        long second = 1;
        long next;

        System.out.println("First 100 Fibonacci Numbers:");

        for (int i = 1; i <= 100; i++) {

            System.out.print(first + " ");

            next = first + second;
            first = second;
            second = next;
        }
    }
}
